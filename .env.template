# ══════════════════════════════════════════════════════════════
#  sailing-knowledge-agent  —  .env.template
#  Copy to .env and fill in your values. Never commit .env.
# ══════════════════════════════════════════════════════════════

# ── LLM (used by: 0_ocr_extract, 1_build_kg, Z_run_sailing) ──
# OpenAI-compatible endpoint (SAP AI Core, Azure, OpenAI, ...)
LLM_ENDPOINT=https://your-endpoint/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=openai/gpt-4o          # litellm model string, e.g. openai/gpt-4o or anthropic/claude-sonnet-5

# ── Embeddings (used by: 1_build_kg via Cognee) ───────────────
EMBEDDING_PROVIDER=openai         # openai | azure | ...
EMBEDDING_ENDPOINT=https://your-endpoint/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Embedding throttle (optional — tune for rate limits) ──────
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_CONCURRENT_DATA_POINTS=4
EMBEDDING_RATE_LIMIT_ENABLED=false
EMBEDDING_RATE_LIMIT_REQUESTS=100
EMBEDDING_RATE_LIMIT_INTERVAL=60

# ── LLM throttle (optional) ────────────────────────
LLM_RATE_LIMIT_ENABLED=false
LLM_RATE_LIMIT_REQUESTS=100
LLM_RATE_LIMIT_INTERVAL=60

# ── Cognee ingestion behaviour (optional) ─────────────────────
RAISE_INCREMENTAL_LOADING_ERRORS=false

# ── VLM for picture description (optional) ─────────
# Only needed when running 0_ocr_extract.py --describe-pictures
VLM_MODEL=openai/gemini-2.5-flash

# ── SAP Sailing API (used by: claudecode/sap_api.py)
# Public endpoints work without credentials.
# Premium: raises competitordata timepoint limit 1k →
SAP_SAILING_USERNAME=
SAP_SAILING_PASSWORD=

# ── LiteLLM / observability extras (optional) ──────
# Used by 2_mcp_server.py to forward headers (e.g. Langfuse tracing).
LITELLM_EXTRA_HEADERS_RAW=
LANGFUSE_TAGS_INJECT=